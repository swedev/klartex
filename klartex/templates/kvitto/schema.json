{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Kvitto",
  "description": "Kvitto / Receipt",
  "type": "object",
  "required": ["receipt_number", "date", "total_amount", "items"],
  "properties": {
    "page_template": {
      "description": "Sidmall: namn eller objekt med overrides (sidnummer, typsnitt, sidfot).",
      "default": "formal",
      "oneOf": [
        { "type": "string", "enum": ["formal", "clean", "none"], "description": "Sidmallens namn" },
        {
          "type": "object",
          "required": ["name"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "enum": ["formal", "clean", "none"], "description": "Sidmallens namn" },
            "page_numbers": { "type": "boolean", "description": "Visa sidnummer i sidfoten" },
            "first_page_header": { "type": "boolean", "description": "Visa sidhuvud på första sidan" },
            "font": { "type": "string", "description": "Dokumentets typsnitt (fontspec-namn, t.ex. 'Futura'). Måste finnas installerat där renderingen sker." },
            "header_font": { "type": "string", "description": "Typsnitt för sidhuvud och sidfot. Default: samma som font." },
            "diff_style": { "type": "string", "enum": ["color", "underline"], "default": "color", "description": "Hur tillagd text markeras: \"color\" (grön text, default) eller \"underline\" (grön understruken \u2014 konventionen i \u00e4ndringsdokument, och den signal som \u00f6verlever svartvit utskrift). Struken text \u00e4r \u00f6verstruken i b\u00e5da fallen." },
            "footer": {
              "type": "object",
              "additionalProperties": false,
              "description": "Sidfot på varje sida med företags-, kontakt- och betalningsuppgifter. För fakturor hör betalningsuppgifterna hemma här — fakturadatats egna bankgiro/plusgiro/iban/bic-fält är bara en fallback och undertrycks när sidfoten har betalningsuppgifter.",
              "properties": {
                "company": { "type": "string", "description": "Företagsnamn" },
                "address": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }], "description": "Postadress som array med en rad per element, t.ex. ['Storgatan 1', '123 45 Stad'] — radbryts som en postadress. En sträng renderas som en enda rad." },
                "seat": { "type": "string", "description": "Styrelsens säte, t.ex. 'Malmö'" },
                "org_number": { "type": "string", "description": "Organisationsnummer" },
                "vat_number": { "type": "string", "description": "Momsregistreringsnummer (SExxxxxxxxxx01)" },
                "f_tax": { "type": "boolean", "description": "true visar raden 'Godkänd för F-skatt'" },
                "phone": { "type": "string", "description": "Telefon" },
                "email": { "type": "string", "description": "E-post" },
                "web": { "type": "string", "description": "Webbplats" },
                "bankgiro": { "type": "string" },
                "plusgiro": { "type": "string" },
                "iban": { "type": "string" },
                "bic": { "type": "string" }
              }
            }
          }
        }
      ]
    },
    "number_format": { "type": "string", "enum": ["sv", "en"], "description": "Talformat för belopp: 'sv' ger 32 400,00 (default), 'en' ger 32,400.00." },
    "logo": { "type": "string", "description": "Bildfil (pdf/png) som visas i kvittots övre vänstra hörn, i linje med KVITTO-blocket. Plain filnamn slås upp via asset-katalogen (sidmallens katalog) och cwd." },
    "logo_height": { "type": "string", "default": "0.8cm", "description": "Logotypens höjd som LaTeX-dimension, t.ex. '1cm'." },
    "logo_offset": {
      "type": "object",
      "additionalProperties": false,
      "description": "Finjustering av logotypens position, som andelar av dess höjd: x positivt flyttar höger (negativt vänster), y positivt flyttar uppåt (negativt neråt). Utgångsläge: vänsterkant vid marginalen, överkant i linje med KVITTO-rubriken.",
      "properties": {
        "x": { "type": "number", "default": 0 },
        "y": { "type": "number", "default": 0 }
      }
    },
    "sender": {
      "type": "object",
      "required": ["name"],
      "description": "Utställare/säljare — visas som Avsändare-block i kvittokroppen. Ange bolagets juridiska namn här även när logotyp/sidfot finns.",
      "properties": {
        "name": { "type": "string" },
        "org_number": { "type": "string" },
        "address_line1": { "type": "string" },
        "address_line2": { "type": "string" }
      }
    },
    "footer": {
      "type": "object",
      "additionalProperties": false,
      "description": "Kvittots sidfot: företags-, kontakt- och betalningsuppgifter på varje sida.",
      "properties": {
        "company": { "type": "string", "description": "Företagsnamn" },
        "address": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }], "description": "Postadress som array med en rad per element, t.ex. ['Storgatan 1', '123 45 Stad'] — radbryts som en postadress. En sträng renderas som en enda rad." },
        "seat": { "type": "string", "description": "Styrelsens säte, t.ex. 'Malmö'" },
        "org_number": { "type": "string", "description": "Organisationsnummer" },
        "vat_number": { "type": "string", "description": "Momsregistreringsnummer (SExxxxxxxxxx01)" },
        "f_tax": { "type": "boolean", "description": "true visar raden 'Godkänd för F-skatt'" },
        "phone": { "type": "string", "description": "Telefon" },
        "email": { "type": "string", "description": "E-post" },
        "web": { "type": "string", "description": "Webbplats" },
        "bankgiro": { "type": "string" },
        "plusgiro": { "type": "string" },
        "iban": { "type": "string" },
        "bic": { "type": "string" }
      }
    },
    "receipt_number": { "type": "string" },
    "date": { "type": "string", "description": "Receipt date (YYYY-MM-DD)" },
    "total_amount": { "type": "number", "description": "Total amount paid. Authoritative — never computed from items." },
    "currency": { "type": "string", "default": "SEK" },
    "payment_method": { "type": "string", "description": "e.g. Kontant, Swish, Kort" },
    "paid_by": { "type": "string", "description": "Name of the payer" },
    "items": {
      "type": "array",
      "description": "What was paid for. Amounts are optional and informational — total_amount is the authoritative total.",
      "items": {
        "type": "object",
        "required": ["description"],
        "properties": {
          "description": { "type": "string" },
          "amount": { "type": "number" }
        }
      },
      "minItems": 1
    },
    "note": { "type": "string", "description": "Footer note" }
  }
}
