{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Kvitto",
  "description": "Kvitto / Receipt",
  "type": "object",
  "required": ["receipt_number", "date", "total_amount", "items"],
  "properties": {
    "page_template": {
      "description": "Sidmall som två oberoende delar: header (sidhuvud) och footer (sidfot). Varje del är en variant, ett objekt med uppgifter, eller null för tomt. Namnet är ett alias för en färdig kombination.",
      "default": "formal",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "formal",
            "clean",
            "none"
          ],
          "description": "Alias för en kombination av sidhuvud och sidfot: 'formal' (letterhead + standard med dokumenttiteln i sidfoten), 'clean' (logo + standard) eller 'none' (tomt sidhuvud + standard)."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "enum": [
                "formal",
                "clean",
                "none"
              ],
              "description": "Alias för en kombination av sidhuvud och sidfot: formal = letterhead + standard med dokumenttiteln i sidfoten, clean = logo + standard, none = tomt sidhuvud + standard. Ett header- eller footer-värde bredvid aliaset ersätter den sidan av kombinationen."
            },
            "page_numbers": {
              "type": "boolean",
              "description": "Visa sidnummer i sidfoten"
            },
            "first_page_header": {
              "type": "boolean",
              "description": "Visa sidhuvud på första sidan"
            },
            "font": {
              "type": "string",
              "description": "Dokumentets typsnitt (fontspec-namn, t.ex. 'Futura'). Måste finnas installerat där renderingen sker."
            },
            "header_font": {
              "type": "string",
              "description": "Typsnitt för sidhuvud och sidfot. Default: samma som font."
            },
            "diff_style": {
              "type": "string",
              "enum": [
                "color",
                "underline"
              ],
              "default": "color",
              "description": "Hur tillagd text markeras: \"color\" (grön text, default) eller \"underline\" (grön understruken — konventionen i ändringsdokument, och den signal som överlever svartvit utskrift). Struken text är överstruken i båda fallen."
            },
            "header": {
              "description": "Sidhuvudets innehåll: null för tomt sidhuvud, ett variantnamn, eller ett objekt med variant och uppgifterna som ska stå där.",
              "oneOf": [
                {
                  "type": "null",
                  "description": "Tomt sidhuvud — inget skrivs överst på sidan."
                },
                {
                  "type": "string",
                  "enum": [
                    "letterhead",
                    "logo"
                  ],
                  "description": "Sidhuvudsvariant utan uppgifter: 'letterhead' (organisationsuppgifter till vänster, logotyp till höger) eller 'logo' (endast logotyp till höger)."
                },
                {
                  "type": "object",
                  "description": "Organisationsuppgifter till vänster och logotyp till höger. Utelämnade uppgifter skrivs inte ut; utan uppgifter och logotyp återtas sidhuvudets utrymme.",
                  "required": [
                    "variant",
                    "org_name"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "variant": {
                      "const": "letterhead"
                    },
                    "org_name": {
                      "type": "string",
                      "description": "Organisationens namn, i fetstil överst till vänster."
                    },
                    "address": {
                      "type": "string",
                      "description": "Postadress, under organisationsnamnet."
                    },
                    "web": {
                      "type": "string",
                      "description": "Webbplats, i sidhuvudets högra textkolumn."
                    },
                    "email": {
                      "type": "string",
                      "description": "E-postadress, i sidhuvudets högra textkolumn."
                    },
                    "phone": {
                      "type": "string",
                      "description": "Telefonnummer, i sidhuvudets högra textkolumn."
                    },
                    "logo": {
                      "type": "string",
                      "description": "Filnamn för logotypen längst upp till höger i sidhuvudet. Filnamnet får inte innehålla LaTeX-specialtecken (\\ # $ % & _ { } ~ ^) och letas upp i asset_dir eller arbetskatalogen.",
                      "pattern": "^[^\\\\#$%&_{}~^]+$"
                    }
                  }
                },
                {
                  "type": "object",
                  "description": "Endast logotyp till höger i sidhuvudet. Utan logotyp återtas sidhuvudets utrymme.",
                  "required": [
                    "variant"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "variant": {
                      "const": "logo"
                    },
                    "logo": {
                      "type": "string",
                      "description": "Filnamn för logotypen längst upp till höger i sidhuvudet. Filnamnet får inte innehålla LaTeX-specialtecken (\\ # $ % & _ { } ~ ^) och letas upp i asset_dir eller arbetskatalogen.",
                      "pattern": "^[^\\\\#$%&_{}~^]+$"
                    }
                  }
                }
              ]
            },
            "footer": {
              "description": "Sidfotens innehåll: null för tom sidfot, 'standard' för sidnummerraden, eller ett objekt med uppgifterna som ska stå där.",
              "oneOf": [
                {
                  "type": "null",
                  "description": "Tom sidfot — inget skrivs längst ned på sidan."
                },
                {
                  "type": "string",
                  "enum": [
                    "standard"
                  ],
                  "description": "Sidnummer centrerat i sidfoten."
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "description": "Sidfotens innehåll. Med kontaktuppgifter blir sidfoten en flerkolumnsfot med företags-, kontakt- och betalningsuppgifter; utan dem står bara sidnumret centrerat.",
                  "properties": {
                    "variant": {
                      "type": "string",
                      "enum": [
                        "standard"
                      ],
                      "description": "Sidfotsvariant. Enda varianten är 'standard'."
                    },
                    "title": {
                      "type": "boolean",
                      "default": false,
                      "description": "true skriver dokumenttiteln före sidnumret i sidfoten. Gäller endast sidnummerraden, inte kontaktuppgiftsfoten."
                    },
                    "company": {
                      "type": "string",
                      "description": "Företagsnamn"
                    },
                    "address": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      ],
                      "description": "Postadress som array med en rad per element, t.ex. ['Storgatan 1', '123 45 Stad'] — radbryts som en postadress. En sträng renderas som en enda rad."
                    },
                    "seat": {
                      "type": "string",
                      "description": "Styrelsens säte, t.ex. 'Malmö'"
                    },
                    "org_number": {
                      "type": "string",
                      "description": "Organisationsnummer"
                    },
                    "vat_number": {
                      "type": "string",
                      "description": "Momsregistreringsnummer (SExxxxxxxxxx01)"
                    },
                    "f_tax": {
                      "type": "boolean",
                      "description": "true visar raden 'Godkänd för F-skatt'"
                    },
                    "phone": {
                      "type": "string",
                      "description": "Telefon"
                    },
                    "email": {
                      "type": "string",
                      "description": "E-post"
                    },
                    "web": {
                      "type": "string",
                      "description": "Webbplats"
                    },
                    "bankgiro": {
                      "type": "string"
                    },
                    "plusgiro": {
                      "type": "string"
                    },
                    "iban": {
                      "type": "string"
                    },
                    "bic": {
                      "type": "string"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "number_format": { "type": "string", "enum": ["sv", "en"], "description": "Talformat för belopp: 'sv' ger 32 400,00 (default), 'en' ger 32,400.00." },
    "logo": { "type": "string", "description": "Bildfil (pdf/png) som visas i kvittots övre vänstra hörn, i linje med KVITTO-blocket. Plain filnamn slås upp via asset-katalogen (sidmallens katalog) och cwd." },
    "logo_height": { "type": "string", "default": "0.8cm", "description": "Logotypens höjd som LaTeX-dimension, t.ex. '1cm'." },
    "logo_offset": {
      "type": "object",
      "additionalProperties": false,
      "description": "Finjustering av logotypens position, som andelar av dess höjd: x positivt flyttar höger (negativt vänster), y positivt flyttar uppåt (negativt neråt). Utgångsläge: vänsterkant vid marginalen, överkant i linje med KVITTO-rubriken.",
      "properties": {
        "x": { "type": "number", "default": 0 },
        "y": { "type": "number", "default": 0 }
      }
    },
    "sender": {
      "type": "object",
      "required": ["name"],
      "description": "Utställare/säljare — visas som Avsändare-block i kvittokroppen. Ange bolagets juridiska namn här även när logotyp/sidfot finns.",
      "properties": {
        "name": { "type": "string" },
        "org_number": { "type": "string" },
        "address_line1": { "type": "string" },
        "address_line2": { "type": "string" }
      }
    },
    "footer": {
      "type": "object",
      "additionalProperties": false,
      "description": "Kvittots sidfot: företags-, kontakt- och betalningsuppgifter på varje sida.",
      "properties": {
        "company": { "type": "string", "description": "Företagsnamn" },
        "address": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }], "description": "Postadress som array med en rad per element, t.ex. ['Storgatan 1', '123 45 Stad'] — radbryts som en postadress. En sträng renderas som en enda rad." },
        "seat": { "type": "string", "description": "Styrelsens säte, t.ex. 'Malmö'" },
        "org_number": { "type": "string", "description": "Organisationsnummer" },
        "vat_number": { "type": "string", "description": "Momsregistreringsnummer (SExxxxxxxxxx01)" },
        "f_tax": { "type": "boolean", "description": "true visar raden 'Godkänd för F-skatt'" },
        "phone": { "type": "string", "description": "Telefon" },
        "email": { "type": "string", "description": "E-post" },
        "web": { "type": "string", "description": "Webbplats" },
        "bankgiro": { "type": "string" },
        "plusgiro": { "type": "string" },
        "iban": { "type": "string" },
        "bic": { "type": "string" }
      }
    },
    "receipt_number": { "type": "string" },
    "date": { "type": "string", "description": "Receipt date (YYYY-MM-DD)" },
    "total_amount": { "type": "number", "description": "Total amount paid. Authoritative — never computed from items." },
    "currency": { "type": "string", "default": "SEK" },
    "payment_method": { "type": "string", "description": "e.g. Kontant, Swish, Kort" },
    "paid_by": { "type": "string", "description": "Name of the payer" },
    "items": {
      "type": "array",
      "description": "What was paid for. Amounts are optional and informational — total_amount is the authoritative total.",
      "items": {
        "type": "object",
        "required": ["description"],
        "properties": {
          "description": { "type": "string" },
          "amount": { "type": "number" }
        }
      },
      "minItems": 1
    },
    "note": { "type": "string", "description": "Footer note" }
  }
}
