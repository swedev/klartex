\BLOCK{from '_financial_macros.tex.jinja' import render_resultatrakning, render_budgettabell, render_notapparat}
\BLOCK{from '_block_macros.tex.jinja' import render_agenda, render_heading, render_description_list}
\BLOCK{from '_footer_macros.tex.jinja' import emit_kxfooter}
\documentclass{klartex-base}
\providecommand{\orgname}{}

\VAR{page_template_source}

%# --- Apply page template overrides (skipped when external template is self-contained) ---
\BLOCK{include '_page_template_overrides.tex.jinja'}

%# --- Template-level footer from the data (e.g. faktura's footer field). ---
%# Emitted after the overrides so it wins over any page-template footer, and
%# works with external page templates too.
\BLOCK{if data.get('footer')}
\VAR{emit_kxfooter(data.footer, page_template.page_numbers)}
\BLOCK{endif}

\BLOCK{if lang == 'en'}
\setdoclang{en}
\BLOCK{endif}

\setdoctitle{\VAR{title}}

\begin{document}

\BLOCK{for comp in components}
%# ---- Component: \VAR{comp.type} ----
\BLOCK{if comp.type == 'heading'}
%# Recipe heading is a title block: a centered heading + optional orgname
%# (from page template) + optional subtitle. The heading itself goes through
%# the shared render_heading; the metadata lines are recipe-specific layout.
\VAR{render_heading(comp.data.get('title', ''), 2, 'center')}
\ifdefempty{\orgname}{}{\begin{center}{\normalsize \orgname\par}\end{center}}
\BLOCK{if comp.data.get('subtitle')}
\begin{center}{\normalsize \VAR{comp.options.get('subtitle_prefix', '')}\VAR{comp.data.subtitle | inline}\par}\end{center}
\BLOCK{endif}

\BLOCK{elif comp.type == 'description_list'}
%# All optional metadata may have been skipped (recipe.py drops optional
%# fields with missing values) — render nothing rather than an empty table.
\BLOCK{if metadata}
\VAR{render_description_list(metadata)}
\BLOCK{endif}

\BLOCK{elif comp.type == 'agenda'}
\VAR{render_agenda(comp.data.get('items', []), comp.options.get('numberingStyle', 'section'), comp.options.get('decisionLabel', 'Beslut:'))}

\BLOCK{elif comp.type == 'invoice_header'}
%# Two columns matching the sender/recipient blocks below: optional logo on
%# the left (in line with "Avsändare"), FAKTURA block on the right with
%# left-aligned content whose left edge lines up with "Mottagare".
\noindent
\begin{minipage}[t]{0.45\textwidth}
\BLOCK{if comp.data.get('logo')}
%# Top-align the logo with the FAKTURA heading: lower it so its top edge
%# sits at the cap height of \LARGE\bfseries "F" — a larger logo then grows
%# downward instead of up past the heading. logo_offset nudges it by
%# fractions of its own height (x: positive = right, y: positive = up) for
%# artwork with built-in air.
\BLOCK{set logo_offset = comp.data.get('logo_offset') or {} }
{\LARGE\bfseries%
\BLOCK{if logo_offset.get('x')}
\hspace*{\VAR{logo_offset.x}\dimexpr\VAR{comp.data.get('logo_height') or '0.8cm'}\relax}%
\BLOCK{endif}
\raisebox{\dimexpr\fontcharht\font`F-\height+\VAR{logo_offset.get('y') or 0}\height\relax}{\includegraphics[height=\VAR{comp.data.get('logo_height') or '0.8cm'}]{\VAR{comp.data.logo}}}}%
\BLOCK{endif}
~
\end{minipage}%
\hfill
\begin{minipage}[t]{0.45\textwidth}
{\LARGE\bfseries FAKTURA}\\[0.5em]
{\normalsize Nr: \VAR{comp.data.get('invoice_number', '')}}\\
{\normalsize Datum: \VAR{comp.data.get('date', '')}}\\
{\normalsize Förfallodatum: \VAR{comp.data.get('due_date', '')}}
\end{minipage}

\vspace{1em}

\BLOCK{elif comp.type == 'invoice_recipient'}
%# Party block: "label\n name / org.nr / address lines". Used for sender
%# and recipient alike.
\BLOCK{macro invoice_party(label, party)}
\textbf{\VAR{label}}\\[0.3em]
\VAR{party.get('name', '')}\\
\BLOCK{if party.get('org_number')}
Org.nr: \VAR{party.org_number}\\
\BLOCK{endif}
\BLOCK{if party.get('address_line1')}
\VAR{party.address_line1}\\
\BLOCK{endif}
\BLOCK{if party.get('address_line2')}
\VAR{party.address_line2}
\BLOCK{endif}
\BLOCK{endmacro}
\noindent
\BLOCK{if comp.data.get('sender')}
%# With a sender: Avsändare | Mottagare side by side, references below.
\begin{minipage}[t]{0.45\textwidth}
\VAR{invoice_party('Avsändare', comp.data.sender)}
\end{minipage}%
\hfill
\begin{minipage}[t]{0.45\textwidth}
\VAR{invoice_party('Mottagare', comp.data.recipient or {})}
\end{minipage}

\vspace{1.5em}

\noindent
\BLOCK{if comp.data.get('reference')}
\textbf{Er referens:} \VAR{comp.data.reference}\\
\BLOCK{endif}
\BLOCK{if comp.data.get('our_reference')}
\textbf{Vår referens:} \VAR{comp.data.our_reference}\\
\BLOCK{endif}
\BLOCK{if comp.data.get('payment_terms')}
\textbf{Betalningsvillkor:} \VAR{comp.data.payment_terms}
\BLOCK{endif}
\BLOCK{else}
\begin{minipage}[t]{0.45\textwidth}
\VAR{invoice_party('Mottagare', comp.data.get('recipient') or {})}
\end{minipage}%
\hfill
\begin{minipage}[t]{0.45\textwidth}
\BLOCK{if comp.data.get('reference')}
\textbf{Er referens:} \VAR{comp.data.reference}\\
\BLOCK{endif}
\BLOCK{if comp.data.get('our_reference')}
\textbf{Vår referens:} \VAR{comp.data.our_reference}\\
\BLOCK{endif}
\BLOCK{if comp.data.get('payment_terms')}
\textbf{Betalningsvillkor:} \VAR{comp.data.payment_terms}
\BLOCK{endif}
\end{minipage}
\BLOCK{endif}

\vspace{2em}

\BLOCK{elif comp.type == 'invoice_table'}
\begin{tabularx}{\textwidth}{Xrrrrr}
\toprule
\textbf{Beskrivning} & \textbf{Antal} & \textbf{Enhet} & \textbf{À-pris} & \textbf{Moms} & \textbf{Belopp} \\
\midrule
\BLOCK{for line in comp.data.get('lines', [])}
\VAR{line.description} & \VAR{line.quantity | num} & \VAR{line.get('unit', 'st')} & \VAR{line.unit_price | money} & \VAR{line.get('vat_percent', 25) | num}\% & \VAR{(line.quantity * line.unit_price) | money} \\
\BLOCK{endfor}
\bottomrule
\end{tabularx}

\vspace{1em}

\BLOCK{set subtotal = namespace(val=0) }
\BLOCK{set vat_total = namespace(val=0) }
\BLOCK{for line in comp.data.get('lines', [])}
\BLOCK{set subtotal.val = subtotal.val + line.quantity * line.unit_price}
\BLOCK{set vat_total.val = vat_total.val + line.quantity * line.unit_price * line.get('vat_percent', 25) / 100}
\BLOCK{endfor}

\begin{flushright}
\begin{tabular}{lr}
\textbf{Summa exkl. moms:} & \VAR{subtotal.val | money} \VAR{comp.data.get('currency') or 'SEK'} \\
\textbf{Moms:} & \VAR{vat_total.val | money} \VAR{comp.data.get('currency') or 'SEK'} \\
\midrule
\textbf{Att betala:} & \textbf{\VAR{(subtotal.val + vat_total.val) | money} \VAR{comp.data.get('currency') or 'SEK'}} \\
\end{tabular}
\end{flushright}

\vspace{2em}

\BLOCK{elif comp.type == 'payment_info'}
%# Suppressed when a footer (the data's own or the page template's) already
%# carries payment details — the footer is the canonical place; these fields
%# are the fallback — and when the data has no payment fields at all.
\BLOCK{set has_payment = comp.data.get('bankgiro') or comp.data.get('plusgiro') or comp.data.get('iban') or comp.data.get('bic') }
\BLOCK{set data_footer = data.get('footer') or {} }
\BLOCK{set footer_payment = page_template.footer_has_payment or data_footer.get('bankgiro') or data_footer.get('plusgiro') or data_footer.get('iban') or data_footer.get('bic') }
\BLOCK{if has_payment and not footer_payment}
\noindent\textbf{Betalningsinformation}\\[0.3em]
\begin{tabular}{@{}ll}
\BLOCK{if comp.data.get('bankgiro')}
\textbf{Bankgiro:} & \VAR{comp.data.bankgiro} \\
\BLOCK{endif}
\BLOCK{if comp.data.get('plusgiro')}
\textbf{Plusgiro:} & \VAR{comp.data.plusgiro} \\
\BLOCK{endif}
\BLOCK{if comp.data.get('iban')}
\textbf{IBAN:} & \VAR{comp.data.iban} \\
\BLOCK{endif}
\BLOCK{if comp.data.get('bic')}
\textbf{BIC:} & \VAR{comp.data.bic} \\
\BLOCK{endif}
\end{tabular}
\BLOCK{endif}

\BLOCK{elif comp.type == 'invoice_note'}
\BLOCK{if comp.data.get('note')}
\vspace{1em}
\noindent\textit{\VAR{comp.data.note}}
\BLOCK{endif}

\BLOCK{elif comp.type == 'receipt_header'}
\begin{flushright}
{\Large\bfseries KVITTO}\\[0.5em]
{\normalsize Nr: \VAR{comp.data.get('receipt_number', '')}}\\
{\normalsize Datum: \VAR{comp.data.get('date', '')}}
\end{flushright}

\vspace{1em}

\BLOCK{elif comp.type == 'receipt_table'}
\begin{tabularx}{\textwidth}{Xr}
\toprule
\textbf{Beskrivning} & \textbf{Belopp} \\
\midrule
\BLOCK{for item in comp.data.get('items', [])}
%# `is not none` (not truthiness): amount 0 must render as 0.00, only a
%# truly absent amount gives an empty cell.
\VAR{item.description} & \BLOCK{if item.get('amount') is not none}\VAR{item.amount | money}\BLOCK{endif} \\
\BLOCK{endfor}
\bottomrule
\end{tabularx}

\vspace{1em}

\begin{flushright}
\begin{tabular}{lr}
\textbf{Summa:} & \textbf{\VAR{comp.data.total_amount | money} \VAR{comp.data.get('currency') or 'SEK'}} \\
\end{tabular}
\end{flushright}

\vspace{1em}

\BLOCK{elif comp.type == 'resultatrakning'}
\VAR{render_resultatrakning(comp.data.rubrik_ar1, comp.data.rubrik_ar2, comp.data.grupper, comp.data.get('resultat'), comp.options.get('section_heading'))}

\BLOCK{elif comp.type == 'budgettabell'}
\VAR{render_budgettabell(comp.data.rubrik_budget, comp.data.rubrik_ar1, comp.data.rubrik_ar2, comp.data.poster)}

\BLOCK{elif comp.type == 'notapparat'}
\BLOCK{if comp.data.get('noter')}
\VAR{render_notapparat(comp.data.noter)}
\BLOCK{endif}

\BLOCK{elif comp.type == 'text'}
\BLOCK{if comp.data.get('text')}
\vspace{1em}
\noindent \VAR{comp.data.text | inline}
\BLOCK{endif}

\BLOCK{endif}
\BLOCK{endfor}

\end{document}
